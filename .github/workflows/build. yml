          import android.content.Context
          import android.os.Build
          import androidx.core.app.NotificationCompat
          import androidx.work.Worker
          import androidx.work.WorkerParameters
          import java.util.Calendar

          class ExpiryWorker(context: Context, params: WorkerParameters) : Worker(context, params) {
              override fun doWork(): Result {
                  try {
                      val p = applicationContext.getSharedPreferences("vehicle", Context.MODE_PRIVATE)
                      val items = mapOf("rca" to "RCA", "rcaPers" to "RCA Persoane", "rcaBag" to "RCA Bagaje", "itp" to "ITP",
                          "stingator" to "Stingător", "trusa" to "Trusă Medicală", "copie" to "Copie Conformă",
                          "ecusoane" to "Ecusoane", "fisa" to "Fișă Medicală")
                      val today = Calendar.getInstance().apply { set(Calendar.HOUR_OF_DAY, 0); set(Calendar.MINUTE, 0); set(Calendar.SECOND, 0); set(Calendar.MILLISECOND, 0) }.timeInMillis
                      for ((k, l) in items) {
                          try {
                              val e = p.getLong(k, 0L)
                              if (e > 0) {
                                  val d = Math.round((e - today) / 86_400_000.0)
                                  if (d == 30L || d == 15L || d == 10L || d == 3L) send(l, d.toInt())
                              }
                          } catch (_: Exception) {}
                      }
                  } catch (_: Exception) {}
                  return Result.success()
              }
              private fun send(l: String, d: Int) {
                  try {
                      val ch = "vehicle_alerts"
                      val nm = applicationContext.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
                      if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) nm.createNotificationChannel(NotificationChannel(ch, "Alerte", NotificationManager.IMPORTANCE_HIGH))
