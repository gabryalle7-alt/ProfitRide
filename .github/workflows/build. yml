          class OfferReader : AccessibilityService() {

              companion object {
                  @Volatile var isStopped = false
                  @Volatile var instance: OfferReader? = null
                  private val PKGS = listOf("ee.mtakso", "com.ubercab", "com.mytaxi", "com.clever")
                  private const val DEDUP_MS = 60_000L
                  private const val HASH_MS = 300L
                  private const val MAX_LOG = 500_000L
                  private const val STALE_PENDING_MS = 10 * 60 * 1000L
                  private const val REOFFER_MS = 30_000L
              }

              private var overlay: View? = null
              private var sideBarView: View? = null
              private var sidePanelView: View? = null
              private lateinit var wm: WindowManager
              private val handler = Handler(Looper.getMainLooper())
              private val autoDismiss = Runnable { removeOverlay() }
              private var tts: TextToSpeech? = null
              private var vibrator: Vibrator? = null
              private val sb = StringBuilder(2048)
              private var lastTextHash = 0
              private var lastTextTime = 0L
              private var lastOfferKey = ""
              private var lastOfferAt = 0L
              private var pendingOffer: OfferParser.Offer? = null
              private var pendingAt = 0L
              private var lastSavedPrice = 0f
              private var lastSavedKm = 0f
              private var lastSavedAt = 0L

              private fun isOfficial(p: String) = PKGS.any { p.startsWith(it) }

              private fun log(m: String) {
                  try {
                      val f = File(filesDir, "debug.txt")
                      if (f.exists() && f.length() > MAX_LOG) f.delete()
                      f.appendText("${System.currentTimeMillis()}: $m\n")
                  } catch (_: Throwable) {}
              }

              private val screenOff = object : BroadcastReceiver() {
                  override fun onReceive(c: Context?, i: Intent?) {
                      if (i?.action == Intent.ACTION_SCREEN_OFF) { removeOverlay(); removeSidePanel() }
                  }
              }

              override fun onServiceConnected() {
                  super.onServiceConnected()
