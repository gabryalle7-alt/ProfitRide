          w('app/src/main/java/ro/profitride/OfferParser.kt', '''
          package ro.profitride

          object OfferParser {
              data class Offer(val priceRon: Float, val pickupKm: Float, val tripKm: Float, val pickupMinutes: Int, val tripMinutes: Int)
              private val PRICE_LBL = Regex("""(\\d+(?:[.,]\\d{1,2})?)\\s*(?:RON|lei)""", RegexOption.IGNORE_CASE)
              private val PRICE_ANY = Regex("""(\\d+(?:[.,]\\d{1,2})?)""")
              private val KM_RE = Regex("""(\\d+(?:[.,]\\d+)?)\\s*km""", RegexOption.IGNORE_CASE)
              private val MIN_RE = Regex("""(\\d+)\\s*min""", RegexOption.IGNORE_CASE)

              fun parse(text: String, avgSpeed: Float = 25f): Offer? {
                  return try {
                      val price = findPrice(text) ?: return null
                      val kms = KM_RE.findAll(text).mapNotNull { it.groupValues[1].replace(',', '.').toFloatOrNull() }.toList()
                      val mins = MIN_RE.findAll(text).mapNotNull { it.groupValues[1].toIntOrNull() }.toList()
                      if (kms.isEmpty()) return null
                      var pk = 0f; var tk = 0f
                      if (kms.size >= 2) { pk = kms[0]; tk = kms[1] } else tk = kms[0]
                      var pm = 0; var tm = 0
                      if (mins.size >= 2) { pm = mins[0]; tm = mins[1] } else if (mins.size == 1) tm = mins[0]
                      if (tm == 0) tm = ((tk / avgSpeed) * 60).toInt()
                      if (pm == 0) pm = ((pk / avgSpeed) * 60).toInt()
                      Offer(price, pk, tk, pm, tm)
                  } catch (_: Throwable) { null }
              }

              private fun findPrice(text: String): Float? {
                  val lbl = PRICE_LBL.findAll(text).mapNotNull { it.groupValues[1].replace(',', '.').toFloatOrNull() }.filter { it in 3f..2000f }.maxOrNull()
                  if (lbl != null) return lbl
                  return PRICE_ANY.findAll(text).mapNotNull { m ->
                      val v = m.groupValues[1]
                      val after = text.substring(m.range.last + 1).take(10).lowercase()
                      if (after.contains("km") || after.contains("min") || after.contains("ron")) null else v.replace(',', '.').toFloatOrNull()
                  }.filter { it in 5f..500f }.maxOrNull()
              }
          }
          ''')

          w('app/src/main/java/ro/profitride/Calc.kt', r'''
          package ro.profitride
          import android.content.Context
          import android.graphics.Color

          object Calc {
              data class Result(val text: String, val color: Int, val label: String, val grossPerKm: Float, val netProfit: Float, val totalExpenses: Float, val commissionCut: Float, val fuelCost: Float, val extraCost: Float, val totalKm: Float, val totalMin: Int, val priceRon: Float, val speech: String)
              private val GREEN = Color.parseColor("#4CAF50")
              private val YELLOW = Color.parseColor("#FFEB3B")
              private val RED = Color.parseColor("#FF5252")

              fun compute(ctx: Context, o: OfferParser.Offer): Result {
                  val p = ctx.getSharedPreferences("cfg", Context.MODE_PRIVATE)
                  val fuel = p.getFloat("fuelPrice", 7.5f)
                  val cons = p.getFloat("consumption", 7f)
                  val com = p.getFloat("commission", 20f)
                  val extra = p.getFloat("extraCost", 0.5f)
                  val minKm = p.getFloat("minPerKm", 2.5f)
                  val totalKm = o.pickupKm + o.tripKm
                  val totalMin = o.pickupMinutes + o.tripMinutes
                  val grossKm = if (totalKm > 0f) o.priceRon / totalKm else 0f
                  val comCut = o.priceRon * com / 100f
                  val fuelCost = totalKm / 100f * cons * fuel
                  val extraCost = totalKm * extra
                  val exp = comCut + fuelCost + extraCost
                  val net = o.priceRon - exp
                  val (label, color) = when {
                      grossKm >= minKm * 1.2f -> "PROFITABIL" to GREEN
                      grossKm >= minKm -> "MEDIU" to YELLOW
                      else -> "NEPROFITABIL" to RED
                  }
                  val text = "[%s]\n%.2f RON/km\n%.1f km · %d min\n%.2f RON".format(label, grossKm, totalKm, totalMin, o.priceRon)
                  val speech = when (label) {
                      "PROFITABIL" -> "Profitabil. %.1f lei pe km.".format(grossKm)
                      "MEDIU" -> "Mediu."
                      else -> "Neprofitabil."
                  }
                  return Result(text, color, label, grossKm, net, exp, comCut, fuelCost, extraCost, totalKm, totalMin, o.priceRon, speech)
              }
          }
          ''')

