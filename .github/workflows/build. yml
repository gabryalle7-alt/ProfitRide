                      addBtn("Auto", Color.parseColor("#E91E63")) { removeSidePanel(); try { startActivity(Intent(this, VehicleActivity::class.java).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)) } catch (_: Exception) {} }
                      addBtn("Opreste", Color.parseColor("#B71C1C")) { isStopped = true; removeSidePanel(); removeSideBar() }
                      val t = if (Build.VERSION.SDK_INT >= 26) WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY else @Suppress("DEPRECATION") WindowManager.LayoutParams.TYPE_PHONE
                      val lp = WindowManager.LayoutParams((280 * d).toInt(), WindowManager.LayoutParams.WRAP_CONTENT, t, WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE, PixelFormat.TRANSLUCENT)
                      lp.gravity = Gravity.START or Gravity.CENTER_VERTICAL; lp.x = (20 * d).toInt()
                      wm.addView(p, lp); sidePanelView = p
                      handler.postDelayed({ removeSidePanel() }, 15000L)
                  } catch (_: Throwable) {}
              }

              private fun lastInfo(): String {
                  return try {
                      val lines = openFileInput("offers.csv").bufferedReader().use { it.readLines() }
                      val last = lines.lastOrNull { it.isNotBlank() } ?: return "Nicio cursa."
                      val p = last.split(",")
                      if (p.size >= 8) {
                          val km = (p[2].toFloatOrNull() ?: 0f) + (p[3].toFloatOrNull() ?: 0f)
                          "Ultima:\nTarif: ${"%.2f".format(p[1].toFloatOrNull() ?: 0f)} RON\nKm: ${"%.1f".format(km)}\nRON/km: ${"%.2f".format(p[4].toFloatOrNull() ?: 0f)}\nNet: ${"%.2f".format(p[7].toFloatOrNull() ?: 0f)}"
                      } else "Incomplet"
                  } catch (_: Exception) { "Nicio cursa." }
              }

              private fun removeSidePanel() { try { sidePanelView?.let { wm.removeView(it) } } catch (_: Throwable) {}; sidePanelView = null }
              private fun removeSideBar() { try { sideBarView?.let { wm.removeView(it) } } catch (_: Throwable) {}; sideBarView = null }

              override fun onInterrupt() { removeOverlay(); removeSideBar(); removeSidePanel() }
              override fun onDestroy() {
                  instance = null
                  removeOverlay(); removeSideBar(); removeSidePanel()
                  try { unregisterReceiver(screenOff) } catch (_: Throwable) {}
                  try { tts?.stop(); tts?.shutdown() } catch (_: Throwable) {}
                  tts = null; super.onDestroy()
              }
          }
