                      c.addView(TextView(this).apply { text = "%.2f RON · %.1f km".format(r.priceRon, r.totalKm); setTextColor(Color.WHITE); textSize = 11f; gravity = Gravity.CENTER })
                      val t = if (Build.VERSION.SDK_INT >= 26) WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY else @Suppress("DEPRECATION") WindowManager.LayoutParams.TYPE_PHONE
                      val p = WindowManager.LayoutParams(WindowManager.LayoutParams.WRAP_CONTENT, WindowManager.LayoutParams.WRAP_CONTENT, t, WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE, PixelFormat.TRANSLUCENT)
                      p.gravity = Gravity.TOP or Gravity.CENTER_HORIZONTAL; p.y = (150 * d).toInt()
