                  return if (v >= 5f) v else 25f
              }
              private fun collect(n: AccessibilityNodeInfo?, b: StringBuilder, d: Int) {
                  if (n == null || d > 40 || b.length > 20000) return
                  n.text?.toString()?.trim()?.let { if (it.isNotEmpty()) b.append(it).append('\n') }
                  n.contentDescription?.toString()?.trim()?.let { if (it.isNotEmpty()) b.append(it).append('\n') }
                  for (i in 0 until n.childCount) collect(n.getChild(i), b, d + 1)
              }
              private fun speak(r: Calc.Result) {
