                      wm = getSystemService(WINDOW_SERVICE) as WindowManager
                      vibrator = if (Build.VERSION.SDK_INT >= 31)
                          (getSystemService(VIBRATOR_MANAGER_SERVICE) as VibratorManager).defaultVibrator
                      else @Suppress("DEPRECATION") getSystemService(VIBRATOR_SERVICE) as Vibrator
                      tts = TextToSpeech(this) { if (it == TextToSpeech.SUCCESS) tts?.language = Locale("ro", "RO") }
                      try { ContextCompat.registerReceiver(this, screenOff, IntentFilter(Intent.ACTION_SCREEN_OFF), ContextCompat.RECEIVER_NOT_EXPORTED) } catch (_: Throwable) {}
                      if (!isStopped) showSideBar()
                      log("SERVICE START")
                  } catch (_: Throwable) {}
              }

              override fun onAccessibilityEvent(event: AccessibilityEvent?) {
                  if (isStopped) return
                  if (event == null) return
                  try {
                      val pkg = event.packageName?.toString()?.lowercase() ?: return
                      if (!isOfficial(pkg)) return

                      // Salvare cand apesi Accept
                      if (event.eventType == AccessibilityEvent.TYPE_VIEW_CLICKED) {
                          val t = "${event.text?.joinToString(" ") ?: ""} ${event.source?.text ?: ""} ${event.source?.contentDescription ?: ""}".lowercase()
                          val now0 = System.currentTimeMillis()
                          val o = pendingOffer
                          if (t.contains("accept") && o != null && now0 - pendingAt < STALE_PENDING_MS) {
                              log("ACCEPT CLICK")
                              saveTrip(o.priceRon, o.pickupKm, o.tripKm, now0)
                              lastSavedPrice = o.priceRon; lastSavedKm = o.pickupKm + o.tripKm; lastSavedAt = now0
                              pendingOffer = null; lastOfferKey = ""
                          }
                          return
                      }

                      val root = rootInActiveWindow ?: return
                      sb.setLength(0); collect(root, sb, 0)
                      val raw = sb.toString().lowercase()
                      if (raw.isEmpty()) return
                      val h = raw.hashCode()
                      val now = System.currentTimeMillis()
                      if (h == lastTextHash && now - lastTextTime < HASH_MS) return
                      lastTextHash = h; lastTextTime = now

                      if (raw.contains("accept")) {
                          val offer = OfferParser.parse(raw, avgSpeed())
                          if (offer != null) {
                              val key = "${offer.priceRon}|${offer.pickupKm}|${offer.tripKm}"
                              if (key != lastOfferKey || now - lastOfferAt > REOFFER_MS) {
                                  lastOfferKey = key
                                  lastOfferAt = now
                                  pendingOffer = offer; pendingAt = now
                                  log("OFERTA: $key")
                                  showOverlay(Calc.compute(this, offer))
                              }
                          }
                      }
                  } catch (e: Throwable) { log("EVT ERR: ${e.message?.take(60)}") }
              }

              private fun saveTrip(price: Float, pk: Float, tk: Float, now: Long) {
                  try {
                      if (Math.abs(price - lastSavedPrice) < 0.05f && Math.abs((pk + tk) - lastSavedKm) < 0.05f && now - lastSavedAt < 3000L) {
                          log("DUP SKIP ${price}RON")
                          return
                      }
                      val offer = OfferParser.Offer(price, pk, tk, pendingOffer?.pickupMinutes ?: 0, pendingOffer?.tripMinutes ?: 0)
                      val r = Calc.compute(this, offer)
                      val line = "$now,$price,$pk,$tk,${r.grossPerKm},${r.totalMin},${r.totalExpenses},${r.netProfit},${r.commissionCut},${r.fuelCost},${r.extraCost}"
                      openFileOutput("offers.csv", MODE_APPEND).bufferedWriter().use { it.appendLine(line) }
                      log("SALVAT: $price RON, ${pk + tk} km")
