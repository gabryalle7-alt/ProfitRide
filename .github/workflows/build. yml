          package ro.profitride
          import android.content.Context
          import android.graphics.Canvas
          import android.graphics.Color
          import android.graphics.Paint
          import android.graphics.RectF
          import android.graphics.Typeface
          import android.view.View

          class GaugeView(context: Context) : View(context) {
              var percent: Float = 0f
              var arcColor: Int = Color.GREEN
              var valueText: String = ""
              var labelText: String = ""
              var subLabelText: String = ""
              private val bgArc = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE; color = Color.parseColor("#333333"); strokeCap = Paint.Cap.ROUND }
              private val fgArc = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE; strokeCap = Paint.Cap.ROUND }
              private val valP = Paint(Paint.ANTI_ALIAS_FLAG).apply { textAlign = Paint.Align.CENTER; typeface = Typeface.DEFAULT_BOLD }
              private val lblP = Paint(Paint.ANTI_ALIAS_FLAG).apply { textAlign = Paint.Align.CENTER; color = Color.WHITE }
              private val subP = Paint(Paint.ANTI_ALIAS_FLAG).apply { textAlign = Paint.Align.CENTER; color = Color.parseColor("#AAAAAA") }

              override fun onDraw(canvas: Canvas) {
                  try {
                      super.onDraw(canvas)
                      val w = width.toFloat(); val h = height.toFloat()
                      if (w <= 0 || h <= 0) return
                      val d = resources.displayMetrics.density
                      val stroke = 12f * d
                      val cx = w / 2; val cy = h / 2
                      val r = Math.min(w, h) / 2 - stroke / 2 - 2f * d
                      if (r <= 0) return
                      bgArc.strokeWidth = stroke; fgArc.strokeWidth = stroke
                      val rf = RectF(cx - r, cy - r, cx + r, cy + r)
                      canvas.drawArc(rf, 135f, 270f, false, bgArc)
                      fgArc.color = arcColor
                      canvas.drawArc(rf, 135f, 270f * percent.coerceIn(0f, 1f), false, fgArc)
                      valP.color = arcColor
                      valP.textSize = Math.min(w, h) * 0.30f
                      canvas.drawText(valueText, cx, cy + valP.textSize * 0.32f, valP)
                      lblP.textSize = Math.min(w, h) * 0.07f
                      canvas.drawText(labelText, cx, cy + valP.textSize * 0.34f + lblP.textSize * 1.1f, lblP)
                      if (subLabelText.isNotEmpty()) {
                          subP.textSize = Math.min(w, h) * 0.055f
                          canvas.drawText(subLabelText, cx, cy - Math.min(w, h) * 0.14f, subP)
                      }
                  } catch (_: Throwable) {}
              }
          }
          ''')

