              private fun dragListener(): View.OnTouchListener {
                  var sx = 0; var sy = 0; var tx = 0f; var ty = 0f; var mv = false
                  return View.OnTouchListener { v, e ->
                      val p = v.tag as? WindowManager.LayoutParams ?: return@OnTouchListener false
                      when (e.action) {
                          MotionEvent.ACTION_DOWN -> { sx = p.x; sy = p.y; tx = e.rawX; ty = e.rawY; mv = false; true }
                          MotionEvent.ACTION_MOVE -> {
                              val dx = (e.rawX - tx).toInt(); val dy = (e.rawY - ty).toInt()
                              if (dx * dx + dy * dy > 100) mv = true
                              if (mv) { p.x = sx + dx; p.y = sy + dy; try { wm.updateViewLayout(v, p) } catch (_: Exception) {} }
                              true
                          }
                          MotionEvent.ACTION_UP -> { if (!mv) removeOverlay(); true }
                          else -> false
                      }
                  }
