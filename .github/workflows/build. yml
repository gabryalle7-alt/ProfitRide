          package ro.profitride
          import android.app.AlertDialog
          import android.os.Bundle
          import android.widget.Button
          import android.widget.TextView
          import androidx.appcompat.app.AppCompatActivity
          import java.util.Calendar

          class SummaryActivity : AppCompatActivity() {
              private lateinit var period: String
              private lateinit var content: TextView
              private lateinit var prefs: android.content.SharedPreferences
              override fun onCreate(savedInstanceState: Bundle?) {
                  super.onCreate(savedInstanceState)
                  try {
                      setContentView(R.layout.activity_summary)
                      period = intent.getStringExtra("PERIOADA") ?: "WEEK"
                      findViewById<TextView>(R.id.tvSummaryTitle).text = when(period) {
                          "DAY" -> "Sumar Zilnic"; "WEEK" -> "Sumar Saptamanal"; "MONTH" -> "Sumar Lunar"; "YEAR" -> "Sumar Anual"; else -> "Sumar"
                      }
                      content = findViewById(R.id.tvSummaryContent)
                      prefs = getSharedPreferences("cfg", MODE_PRIVATE)
                      load()
                      findViewById<Button>(R.id.btnResetSummary).setOnClickListener {
                          AlertDialog.Builder(this).setTitle("Reset").setMessage("Stergi datele?")
                              .setPositiveButton("Da") { _, _ -> prefs.edit().putLong("reset_$period", System.currentTimeMillis()).apply(); load() }
                              .setNegativeButton("Nu", null).show()
                      }
                  } catch (e: Exception) { finish() }
              }
              private fun load() {
                  var cnt = 0; var rev = 0f; var exp = 0f; var net = 0f
                  var com = 0f; var fuel = 0f; var wear = 0f; var kmT = 0f; var corrupt = 0
                  var minT = 0f; var revH = 0f
                  val eff = maxOf(getStart(), prefs.getLong("reset_$period", 0L))
                  try {
                      openFileInput("offers.csv").bufferedReader().useLines { lines ->
                          lines.forEach { line ->
                              try {
                                  val t = line.trim()
                                  if (t.isEmpty()) return@forEach
                                  val p = t.split(",")
                                  if (p.size < 8) { corrupt++; return@forEach }
                                  val ts = p[0].toLongOrNull() ?: run { corrupt++; return@forEach }
                                  if (ts < eff) return@forEach
                                  cnt++
                                  val lineRev = p[1].toFloatOrNull() ?: 0f
                                  rev += lineRev
                                  kmT += (p[2].toFloatOrNull() ?: 0f) + (p[3].toFloatOrNull() ?: 0f)
                                  val lineMin = p[5].toFloatOrNull() ?: 0f
                                  if (lineMin > 0f) { minT += lineMin; revH += lineRev }
                                  exp += p[6].toFloatOrNull() ?: 0f
                                  net += p[7].toFloatOrNull() ?: 0f
                                  if (p.size >= 11) { com += p[8].toFloatOrNull() ?: 0f; fuel += p[9].toFloatOrNull() ?: 0f; wear += p[10].toFloatOrNull() ?: 0f }
                              } catch (_: Exception) { corrupt++ }
                          }
                      }
                  } catch (_: Exception) {}
                  val avg = if (kmT > 0f) rev / kmT else 0f
                  val hInfo = if (minT > 0f) "\\nRON/oră: ${"%.2f".format(revH / (minT / 60f))}" else ""
                  val cInfo = if (corrupt > 0) "\\n⚠ $corrupt linii corupte" else ""
                  content.text = "CURSE: $cnt\\nKM: ${"%.1f".format(kmT)}\\n----------\\nVENITURI: ${"%.2f".format(rev)} RON\\nTarif mediu: ${"%.2f".format(avg)} RON/km$hInfo\\n----------\\nCHELTUIELI:\\nComision: ${"%.2f".format(com)}\\nCombustibil: ${"%.2f".format(fuel)}\\nUzura: ${"%.2f".format(wear)}\\nTotal: ${"%.2f".format(exp)} RON\\n----------\\nPROFIT NET: ${"%.2f".format(net)} RON$cInfo"
              }
              private fun getStart(): Long {
                  val c = Calendar.getInstance()
                  when (period) {
                      "DAY" -> { c.set(Calendar.HOUR_OF_DAY, 0); c.set(Calendar.MINUTE, 0); c.set(Calendar.SECOND, 0); c.set(Calendar.MILLISECOND, 0) }
                      "WEEK" -> { c.set(Calendar.DAY_OF_WEEK, c.firstDayOfWeek); c.set(Calendar.HOUR_OF_DAY, 0); c.set(Calendar.MINUTE, 0); c.set(Calendar.SECOND, 0); c.set(Calendar.MILLISECOND, 0) }
                      "MONTH" -> { c.set(Calendar.DAY_OF_MONTH, 1); c.set(Calendar.HOUR_OF_DAY, 0); c.set(Calendar.MINUTE, 0); c.set(Calendar.SECOND, 0); c.set(Calendar.MILLISECOND, 0) }
                      "YEAR" -> { c.set(Calendar.DAY_OF_YEAR, 1); c.set(Calendar.HOUR_OF_DAY, 0); c.set(Calendar.MINUTE, 0); c.set(Calendar.SECOND, 0); c.set(Calendar.MILLISECOND, 0) }
                  }
                  return c.timeInMillis
              }
          }
