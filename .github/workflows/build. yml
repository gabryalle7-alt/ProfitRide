                          .setContentTitle("Atentie! $l expira curand!").setContentText("Mai ai $d zile: $l.")
                          .setPriority(NotificationCompat.PRIORITY_HIGH).setAutoCancel(true).build()
                      nm.notify(l.hashCode(), n)
                  } catch (_: Exception) {}
              }
          }
